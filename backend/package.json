{
  "name": "backend",
  "version": "1.0.0",
  "description": "DevPilot AI Backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test dist-test/test/chunker.test.js dist-test/test/workspace.test.js dist-test/test/agent.test.js",
    "test:integration": "npm run build:test && node --test dist-test/test/integration.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "migrate:local": "node scripts/migrate.js",
    "doctor": "npm run build && node scripts/doctor.js",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-glob": "^3.3.3",
    "fastify": "^5.11.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
